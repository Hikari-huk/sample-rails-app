<!DOCTYPE html>
<html>
  <%= render 'layouts/rails_default' %>
  <body>
    <%= render 'layouts/header' %>

    <!-- 固定ヘッダーと重ならないように余白を確保（CSS側で body { padding-top: 70px } 推奨） -->
    <main class="container">
      <%= yield %>
      <%= render 'layouts/footer' %>
    </main>

    <!-- JS (Importmap) -->
    <%= javascript_importmap_tags %>
  </body>
</html>