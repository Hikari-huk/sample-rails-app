<!DOCTYPE html>
<html>
  <head>
    <title><%= full_title(yield(:title)) %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta charset="utf-8">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- CSS (Sprockets/Asset Pipeline で生成された application.css を読む) -->
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>

  <body>
    <header>
      <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
        <div class="container">
          <%= link_to "SAMPLE APP", "#", id: "logo", class: "navbar-brand" %>

          <!-- ハンバーガー -->
          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                  aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
          </button>

          <!-- メニュー -->
          <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
              <li class="nav-item"><%= link_to "Home", "#", class: "nav-link" %></li>
              <li class="nav-item"><%= link_to "Help", "#", class: "nav-link" %></li>
              <li class="nav-item"><%= link_to "Log in", "#", class: "nav-link" %></li>
            </ul>
          </div>
        </div>
      </nav>
    </header>

    <!-- 固定ヘッダーと重ならないように余白を確保（CSS側で body { padding-top: 70px } 推奨） -->
    <main class="container">
      <%= yield %>
    </main>

    <!-- JS (Importmap) -->
    <%= javascript_importmap_tags %>
  </body>
</html>