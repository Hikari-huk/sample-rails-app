{
  "name": "app",
  "private": "true",
  "dependencies": {
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "sass": "^1.93.2",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "autoprefixer": "^10.4.21"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  },
  "scripts": {
    "build:css:compile": "./node_modules/.bin/sass app/assets/stylesheets/application.scss:app/assets/builds/application.css --no-source-map --load-path=node_modules",
    "build:css:prefix": "./node_modules/.bin/postcss app/assets/builds/application.css --use autoprefixer -o app/assets/builds/application.css",
    "build:css": "npm run build:css:compile && npm run build:css:prefix",
    "watch:css": "npx nodemon --watch app/assets/stylesheets --ext scss --exec \"npm run build:css\""
  }
}
